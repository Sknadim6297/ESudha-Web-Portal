# Copy this file to .env in the project root and replace these placeholders.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=esudha_db
DB_USER=your_database_username
DB_PASS=replace_with_your_database_password

# Optional admin provisioning/synchronization values. Set real values only
# in your ignored .env file or the protected production environment.
# ESUDHA_ADMIN_NAME=Live Admin
# ESUDHA_ADMIN_EMAIL=admin@example.com
# ESUDHA_ADMIN_PASSWORD=use-a-unique-password
# ESUDHA_ADMIN_EXPECTED_EMAIL=current-id-1-email@example.com

# Optional absolute path to a protected environment file outside the web root.
# ESUDHA_ENV_FILE=/absolute/path/to/private/esudha.env
